datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int      @id @default(autoincrement())
  telegramId BigInt  @unique
  name      String
  username  String?
  phone     String?
  createdAt DateTime @default(now())
  orders    Order[]
}

model Service {
  id          Int       @id @default(autoincrement())
  name        String
  shortDesc   String
  fullDesc    Json
  icon        String
  category    String
  basePrice   Float
  orderIndex  Int       @default(0)
  isActive    Boolean   @default(true)
  packages    Package[]
}

model Package {
  id          Int      @id @default(autoincrement())
  serviceId   Int
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  name        String
  price       Float
  duration    Int
  features    Json
}

model Portfolio {
  id          Int      @id @default(autoincrement())
  title       String
  category    String
  mediaUrl    String
  description String
  createdAt   DateTime @default(now())
}

model Order {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  serviceName String
  packageName String
  brief       String
  budget      String
  phone       String
  status      String   @default("yangi")
  createdAt   DateTime @default(now())
}